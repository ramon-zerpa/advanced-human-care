                      "fill": "$ahc-muted",
                      "textGrowth": "fixed-width",
                      "width": "fill_container",
                      "content": "Manual therapy, also called hands-on physical therapy, uses no devices or machines. In general, it includes soft-tissue work and joint mobilization.",
                      "lineHeight": 1.55,
                      "fontFamily": "$ahc-body",
                      "fontSize": 16,
                      "fontWeight": "normal"
                    }
