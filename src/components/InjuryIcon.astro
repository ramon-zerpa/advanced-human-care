---
// Original anatomical line icons; no runtime library or external asset request.
export type InjuryArea = 'neck' | 'back' | 'knee' | 'shoulder';
interface Props { area: InjuryArea; size?: number; }
const { area, size = 32 } = Astro.props;
---
<svg xmlns="http://www.w3.org/2000/svg" width={size} height={size} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.65" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {area === 'neck' && <>
    <path d="M10 16c-3-2-4-5-3-8 1-4 6-6 10-4 3 1 4 4 4 7l2 3h-3v3h-4v4l7 5M10 16v6l-5 4" />
    <circle cx="10" cy="19" r="3" />
    <path d="M10 18v2" />
  </>}
  {area === 'back' && <>
    <path d="M12 4v4l-6 3-2 10M20 4v4l6 3 2 10M9 14l2 7-1 7M23 14l-2 7 1 7M16 9v9" />
    <path d="M14.5 11h3M14.5 14h3M14.5 17h3" />
    <circle cx="16" cy="23" r="4" />
    <path d="M16 21v4" />
  </>}
  {area === 'knee' && <>
    <path d="M12 3l-2 10c-.5 3 0 4 2 6l7 9M20 4l-2 10 8 9M13 7l-1 5M19 21l4 4" />
    <circle cx="15" cy="16" r="4" />
    <path d="m14 15 2 2" />
  </>}
  {area === 'shoulder' && <>
    <path d="M12 4v5l-6 3c-2 1-3 3-3 6v9M20 4v5l6 3c2 1 3 3 3 6v9M9 19v9M23 20v8M12 9c2 2 6 2 8 0" />
    <circle cx="23" cy="15" r="4" />
    <path d="M23 13v4" />
  </>}
</svg>
