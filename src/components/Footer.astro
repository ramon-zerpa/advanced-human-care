---
import Icon from './Icon.astro';
interface Props { locale?: 'en' | 'es'; }
const { locale = 'en' } = Astro.props;
---
<footer class="bottom-bar"><div class="container bottom-bar-inner"><p>© {new Date().getFullYear()} Advanced Human Care. {locale === 'es' ? 'Todos los derechos reservados.' : 'All rights reserved.'}</p><a href="#top">{locale === 'es' ? 'Volver al inicio' : 'Back to top'}<Icon name="ArrowUp" size={18} /></a></div></footer>
