---
import Icon from './Icon.astro';
interface Props { compact?: boolean; class?: string; locale?: 'en' | 'es'; }
const { compact = false, class: className, locale = 'en' } = Astro.props;
---
<a href="#contact-us" class:list={['button button-primary', { 'button-compact': compact }, className]}>
  <span>{locale === 'es' ? 'Solicitar una cita' : 'Request an appointment'}</span><Icon name="ArrowUpRight" size={compact ? 16 : 18} />
</a>
