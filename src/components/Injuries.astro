---
import { injuries } from '../data/site';
import InjuryIcon from './InjuryIcon.astro';
---
<section class="section injuries" aria-labelledby="injuries-title">
  <div class="container">
    <div class="section-intro"><h2 id="injuries-title">Care For Common Car Accident Injuries.</h2><p>Our rehabilitation team helps you recover from injuries sustained in a car accident.</p></div>
    <div class="injury-grid">{injuries.map(item => <article><span class="injury-icon"><InjuryIcon area={item.icon} /></span><div class="injury-copy"><h3>{item.title}</h3><p>{item.copy}</p></div></article>)}</div>
  </div>
</section>

<script>
  const items = document.querySelectorAll<HTMLElement>('.injury-grid > article');
  if ('IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let remaining = items.length;
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        entry.target.classList.add('is-revealed');
        observer.unobserve(entry.target);
        if (--remaining === 0) observer.disconnect();
      }
    }, { threshold: 0.15 });
    items.forEach(item => observer.observe(item));
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
    window.addEventListener('pagehide', () => observer.disconnect(), { once: true });
  }
</script>

<style>
  /* Visible by default, including without JavaScript; each block enters only once. */
  .injury-grid > article.is-revealed {
    animation: injury-enter 1200ms cubic-bezier(.25, .1, .25, 1) both;
  }
  .injury-grid > article:nth-child(2) { animation-delay: 180ms; }
  .injury-grid > article:nth-child(3) { animation-delay: 360ms; }
  .injury-grid > article:nth-child(4) { animation-delay: 540ms; }
  @keyframes injury-enter {
    from { opacity: 0; transform: translateY(16px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (max-width: 759px) {
    .injury-grid > article.is-revealed { animation-delay: 0ms; }
    @keyframes injury-enter {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .injury-grid > article.is-revealed { animation: none; }
  }
</style>
