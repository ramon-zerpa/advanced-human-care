---
import { team } from '../data/site';
import AppointmentButton from './AppointmentButton.astro';
---
<section id="about-us" class="section team-section" aria-labelledby="team-title">
  <div class="container split-layout">
    <div class="split-intro"><h2 id="team-title">Our Team.</h2><p>At Advanced Human Care, we are specialists in car accident injury rehabilitation. Our therapists are qualified experts in treating injuries you may have suffered.</p><p>The goal of physical rehabilitation is to help you repair and strengthen damaged muscles and tissues.</p><AppointmentButton /></div>
    <div class="team-grid">{team.map((member, index) => <div class:list={['team-member', { 'team-director': index === 0 }]}><h3>{member.name}</h3><p>{member.role}</p></div>)}</div>
  </div>
</section>
