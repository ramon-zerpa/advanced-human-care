---
import { clinic, navigation } from '../data/site';
import Icon from './Icon.astro';
import AppointmentButton from './AppointmentButton.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
---
<header id="top" class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <span class="topbar-location"><Icon name="MapPin" size={16} />Tampa, Florida</span>
      <a class="topbar-email" href={`mailto:${clinic.email}`}><Icon name="Mail" size={16} />{clinic.email}</a>
      <a class="topbar-mobile-phone" href={clinic.phoneHref}><Icon name="Phone" size={16} />{clinic.phone}</a>
    </div>
  </div>
  <div class="container navigation-bar">
    <a href="#top" class="logo-link" aria-label="Advanced Human Care — back to top"><img src="/logo.png" alt="Advanced Human Care" width="215" height="95" /></a>
    <nav class="desktop-navigation" aria-label="Main navigation">{navigation.map(item => <a href={item.href}>{item.label}</a>)}</nav>
    <div class="desktop-header-actions">
      <a href={clinic.phoneHref} class="button header-phone"><Icon name="Phone" size={18} /><span>{clinic.phone}</span></a>
      <LanguageSwitcher />
    </div>
    <button class="menu-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="mobile-menu">
      <span class="menu-open-icon"><Icon name="Menu" size={24} /></span><span class="menu-close-icon" hidden><Icon name="X" size={24} /></span>
    </button>
  </div>
  <nav id="mobile-menu" class="mobile-menu container" aria-label="Mobile navigation" hidden>
    <div class="mobile-menu-links">{navigation.map(item => <a href={item.href}>{item.label}</a>)}</div>
    <div class="mobile-menu-actions"><LanguageSwitcher /><AppointmentButton compact /></div>
  </nav>
  <noscript><nav class="no-script-menu container" aria-label="Navigation">{navigation.map(item => <a href={item.href}>{item.label}</a>)}</nav></noscript>
</header>
<script>
  import '../scripts/navigation';
</script>

<style>
  .logo-link {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }
  .logo-link::after {
    content: "";
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    pointer-events: none;
    background: linear-gradient(
      135deg,
      #ffffff00 36%,
      #ffffff1f 44%,
      #ffffff57 48%,
      #ffffff8c 50%,
      #ffffff57 52%,
      #ffffff1f 56%,
      #ffffff00 64%
    );
    filter: blur(3.2px);
    opacity: 0;
    transform: translate(-32%, -32%);
    animation: logo-shine 6s 6s ease-in-out infinite;
  }
  .header-phone { animation: phone-attention 4s 4s ease-in-out infinite; }
  .header-phone :global(svg) { animation: phone-icon-attention 4s 4s ease-in-out infinite; }
  @keyframes phone-attention {
    0%, 16%, 100% { transform: translateY(0); box-shadow: none; }
    5%, 10% { transform: translateY(-2px); box-shadow: 0 6px 18px #174a3a38; }
  }
  @keyframes phone-icon-attention {
    0%, 16%, 100% { transform: rotate(0); }
    5%, 10% { transform: rotate(-8deg); }
  }
  @keyframes logo-shine {
    0% { opacity: 0; transform: translate(-32%, -32%); }
    4% { opacity: 1; }
    36% { opacity: 1; }
    40%, 100% { opacity: 0; transform: translate(32%, 32%); }
  }
  /* Keep the original hover and keyboard focus responsive during the cycle. */
  .header-phone:focus-visible {
    animation: none;
    transform: translateY(-2px);
    box-shadow: 0 6px 18px #174a3a38;
  }
  .header-phone:focus-visible :global(svg) { animation: none; transform: rotate(-8deg); }
  @media (hover: hover) {
    .header-phone:hover {
      animation: none;
      transform: translateY(-2px);
      box-shadow: 0 6px 18px #174a3a38;
    }
    .header-phone:hover :global(svg) { animation: none; transform: rotate(-8deg); }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-link::after, .header-phone, .header-phone :global(svg) { animation: none; }
    .logo-link::after { opacity: 0; }
    .header-phone:hover, .header-phone:focus-visible { transform: none; }
    .header-phone:hover :global(svg), .header-phone:focus-visible :global(svg) { transform: none; }
  }
</style>
