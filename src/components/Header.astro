---
import { clinic, navigation, spanish } from '../data/site';
import Icon from './Icon.astro';
import AppointmentButton from './AppointmentButton.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
interface Props { locale?: 'en' | 'es'; }
const { locale = 'en' } = Astro.props;
const isSpanish = locale === 'es';
const localClinic = isSpanish ? spanish.clinic : clinic;
const localNavigation = isSpanish ? spanish.navigation : navigation;
---
<header id="top" class="site-header">
  <div class="topbar">
    <div class="container topbar-inner">
      <span class="topbar-location"><Icon name="MapPin" size={16} />Tampa, Florida</span>
      <a class="topbar-email" href={`mailto:${localClinic.email}`}><Icon name="Mail" size={16} />{localClinic.email}</a>
      <a class="topbar-mobile-phone" href={localClinic.phoneHref}><Icon name="Phone" size={16} />{localClinic.phone}</a>
    </div>
  </div>
  <div class="container navigation-bar">
    <a href="#top" class="logo-link" aria-label={isSpanish ? 'Advanced Human Care — volver al inicio' : 'Advanced Human Care — back to top'}><img src="/logo.png" alt="Advanced Human Care" width="215" height="95" /></a>
    <nav class="desktop-navigation" aria-label={isSpanish ? 'Navegación principal' : 'Main navigation'}>{localNavigation.map(item => <a href={item.href}>{item.label}</a>)}</nav>
    <div class="desktop-header-actions">
      <a href={localClinic.phoneHref} class="button header-phone"><Icon name="Phone" size={18} /><span>{localClinic.phone}</span></a>
      <LanguageSwitcher locale={locale} />
    </div>
    <button class="menu-toggle" type="button" aria-label={isSpanish ? 'Abrir menú de navegación' : 'Open navigation menu'} data-label-open={isSpanish ? 'Abrir menú de navegación' : 'Open navigation menu'} data-label-close={isSpanish ? 'Cerrar menú de navegación' : 'Close navigation menu'} aria-expanded="false" aria-controls="mobile-menu">
      <span class="menu-open-icon"><Icon name="Menu" size={24} /></span><span class="menu-close-icon" hidden><Icon name="X" size={24} /></span>
    </button>
  </div>
  <nav id="mobile-menu" class="mobile-menu container" aria-label={isSpanish ? 'Navegación móvil' : 'Mobile navigation'} hidden>
    <div class="mobile-menu-links">{localNavigation.map(item => <a href={item.href}>{item.label}</a>)}</div>
    <div class="mobile-menu-actions"><LanguageSwitcher locale={locale} /><AppointmentButton compact locale={locale} /></div>
  </nav>
  <noscript><nav class="no-script-menu container" aria-label={isSpanish ? 'Navegación' : 'Navigation'}>{localNavigation.map(item => <a href={item.href}>{item.label}</a>)}</nav></noscript>
</header>
<script>
  import '../scripts/navigation';
</script>
