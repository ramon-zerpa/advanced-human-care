---
import { Image } from 'astro:assets';
import care from '../assets/images/hero-scenes/personalized-care.png';
import space from '../assets/images/hero-scenes/rehabilitation-space.png';
import { clinic } from '../data/site';
import Icon from './Icon.astro';
import AppointmentButton from './AppointmentButton.astro';
---
<section class="hero canvas" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero-layout">
      <div class="hero-copy">
        <h1 id="hero-title">Car Accident Rehabilitation In Tampa.</h1>
        <p>At Advanced Human Care, our therapists are highly skilled experts in treating injuries you may have sustained in a car accident.</p>
        <p>Get your lifestyle back with physical rehabilitation focused on your recovery.</p>
        <div class="hero-actions"><AppointmentButton /><a href={clinic.phoneHref} class="button button-outline"><Icon name="Phone" size={18} /><span>{clinic.phone}</span></a></div>
      </div>
      <div class="hero-media">
        <div class="hero-editorial">
          <Image src={care} alt="" width={1160} height={870} widths={[360, 580, 800, 1160]} sizes="(min-width: 1120px) 522px, (min-width: 760px) 45vw, calc(100vw - 48px)" format="webp" quality={82} loading="eager" fetchpriority="high" class="editorial-main" />
          <Image src={space} alt="" width={580} height={435} widths={[200, 360, 580]} sizes="(min-width: 1120px) 209px, (min-width: 760px) 18vw, 1px" format="webp" quality={82} loading="lazy" fetchpriority="low" class="editorial-detail" />
          <p class="editorial-message"><Icon name="Activity" size={28} /><span>Get Your Lifestyle Back.</span></p>
        </div>
        <p class="editorial-note">Illustrative scenes · Not actual clinic photographs.</p>
      </div>
    </div>
    <div class="hero-details">
      <a href={clinic.maps} target="_blank" rel="noopener noreferrer"><Icon name="MapPin" size={20} /><span>{clinic.address}</span><span class="sr-only"> (opens in a new tab)</span></a>
      <p><Icon name="Clock3" size={20} /><span>{clinic.hours}</span></p>
    </div>
  </div>
</section>

<script>
  const composition = document.querySelector<HTMLElement>('.hero-editorial');
  if (composition && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const observer = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      composition.classList.add('is-introduced');
      observer.disconnect();
    });
    observer.observe(composition);
    document.addEventListener('astro:before-swap', () => observer.disconnect(), { once: true });
    window.addEventListener('pagehide', () => observer.disconnect(), { once: true });
  }
</script>

<style>
  .hero-copy, .hero-media { animation: none; }
  .hero-editorial {
    position: relative;
    aspect-ratio: 1.2;
    isolation: isolate;
  }
  .editorial-main, .editorial-detail {
    position: absolute;
    object-fit: cover;
    border-radius: 12px;
    box-shadow: var(--image-shadow);
    pointer-events: none;
  }
  .editorial-main {
    top: 8px;
    left: 8px;
    width: 90%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-position: center top;
  }
  .editorial-detail {
    right: 12px;
    bottom: 12px;
    width: 36%;
    height: auto;
    aspect-ratio: 4 / 3;
    border: 5px solid var(--canvas);
    transform: rotate(3deg);
    z-index: 2;
  }
  .editorial-message {
    position: absolute;
    left: 0;
    bottom: 42px;
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 70%;
    padding: 20px 22px;
    border-radius: 10px;
    background: var(--sage);
    color: var(--forest);
    box-shadow: var(--button-shadow);
    font: italic 600 24px/1.2 var(--font-heading);
    z-index: 3;
  }
  .is-introduced .editorial-main { animation: editorial-main-in 650ms cubic-bezier(.22,.61,.36,1) both; }
  .is-introduced .editorial-detail { animation: editorial-detail-in 650ms 120ms cubic-bezier(.22,.61,.36,1) both; }
  .is-introduced .editorial-message { animation: editorial-message-in 600ms 240ms cubic-bezier(.22,.61,.36,1) both; }
  .editorial-note {
    margin-top: 12px;
    color: var(--muted);
    font-size: 12px;
  }
  @keyframes editorial-main-in {
    from { transform: translateY(20px); }
    to { transform: translateY(0); }
  }
  @keyframes editorial-detail-in {
    from { opacity: 0; transform: translateX(18px) rotate(2deg); }
    to { opacity: 1; transform: translateX(0) rotate(3deg); }
  }
  @keyframes editorial-message-in {
    from { opacity: 0; transform: translateY(12px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @media (min-width: 760px) and (max-width: 1119px) {
    .hero-layout { gap: 32px; }
    .editorial-detail { width: 30%; transform: rotate(2deg); }
    .is-introduced .editorial-detail { animation-name: editorial-detail-tablet-in; }
    .editorial-message { bottom: 28px; padding: 14px; font-size: 18px; gap: 8px; }
    .editorial-message svg { width: 22px; height: 22px; }
    @keyframes editorial-detail-tablet-in {
      from { opacity: 0; transform: translateX(12px) rotate(2deg); }
      to { opacity: 1; transform: translateX(0) rotate(2deg); }
    }
  }
  @media (max-width: 759px) {
    .hero-editorial { aspect-ratio: auto; padding-bottom: 30px; }
    .editorial-main {
      position: relative;
      top: auto;
      left: auto;
      width: 100%;
      max-height: 320px;
    }
    .editorial-detail { display: none; }
    .editorial-message {
      left: 12px;
      right: 12px;
      bottom: 0;
      max-width: none;
      padding: 16px;
      font-size: 21px;
    }
    .is-introduced .editorial-main { animation: editorial-mobile-in 550ms ease-out both; }
    .is-introduced .editorial-detail { animation: none; }
    .is-introduced .editorial-message { animation: editorial-mobile-in 550ms 80ms ease-out both; }
    @keyframes editorial-mobile-in {
      from { transform: translateY(8px); }
      to { transform: translateY(0); }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .is-introduced .editorial-main, .is-introduced .editorial-detail, .is-introduced .editorial-message { animation: none; }
  }
</style>
