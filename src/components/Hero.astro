---
import { Image } from 'astro:assets';
import care from '../assets/images/hero-scenes/personalized-care.png';
import exercise from '../assets/images/hero-scenes/assisted-mobility.png';
import space from '../assets/images/hero-scenes/rehabilitation-space.png';
const scenes = [care, exercise, space];
import { clinic } from '../data/site';
import Icon from './Icon.astro';
import AppointmentButton from './AppointmentButton.astro';
---
<section class="hero canvas" aria-labelledby="hero-title" data-hero-scenes>
  <div class="container">
    <div class="hero-layout">
      <div class="hero-copy">
        <h1 id="hero-title">Car Accident Rehabilitation In Tampa.</h1>
        <p>At Advanced Human Care, our therapists are highly skilled experts in treating injuries you may have sustained in a car accident.</p>
        <p>Get your lifestyle back with physical rehabilitation focused on your recovery.</p>
        <div class="hero-actions"><AppointmentButton /><a href={clinic.phoneHref} class="button button-outline"><Icon name="Phone" size={18} /><span>{clinic.phone}</span></a></div>
      </div>
      <div class="hero-media">
        <div class="scene-frame">
          <div class="scene-window" aria-hidden="true">
            {scenes.map((src, index) => <Image src={src} alt="" width={1160} height={870} widths={[360, 580, 800, 1160]} sizes="(min-width: 1120px) 580px, (min-width: 760px) 50vw, calc(100vw - 48px)" format="webp" quality={82} loading={index === 0 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'low'} class={`hero-scene ${index === 0 ? 'is-current' : ''}`} />)}
          </div>
        </div>
        <div class="scene-meta">
          <p>Illustrative scenes · Not actual clinic photographs.</p>
          <button class="scene-toggle" type="button" aria-pressed="false" hidden><Icon name="Pause" size={14} /><span>Pause scenes</span></button>
        </div>
        <p class="recovery-caption"><Icon name="Activity" size={28} /><span>Get Your Lifestyle Back.</span></p>
      </div>
    </div>
    <div class="hero-details">
      <a href={clinic.maps} target="_blank" rel="noopener noreferrer"><Icon name="MapPin" size={20} /><span>{clinic.address}</span><span class="sr-only"> (opens in a new tab)</span></a>
      <p><Icon name="Clock3" size={20} /><span>{clinic.hours}</span></p>
    </div>
  </div>
</section>

<script>
  import '../scripts/hero-scenes';
</script>

<style>
  .hero-copy, .hero-media { animation: none; }
  .scene-frame {
    padding: 8px 0 0 8px;
    background: var(--sage);
    border-radius: 18px;
  }
  .scene-window {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 12px;
    background: var(--sage);
    box-shadow: var(--image-shadow);
  }
  .hero-scene {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    visibility: hidden;
    pointer-events: none;
  }
  .hero-scene.is-current { visibility: visible; z-index: 1; }
  .hero-scene.is-entering {
    visibility: visible;
    z-index: 2;
    animation: scene-reveal 1100ms cubic-bezier(.25,.1,.25,1) both;
  }
  @keyframes scene-reveal {
    from { clip-path: inset(0 0 0 100%); transform: translateX(12px); }
    to { clip-path: inset(0); transform: translateX(0); }
  }
  .scene-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
    color: var(--muted);
    font-size: 12px;
  }
  .scene-toggle {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 36px;
    padding: 6px 10px;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: var(--canvas);
    color: var(--forest);
    font-size: 12px;
  }
  .scene-toggle[hidden] { display: none; }
  .scene-toggle[aria-pressed="true"] { background: var(--sage); }
  .scene-toggle[aria-pressed="true"] svg { display: none; }
  .scene-toggle:disabled { cursor: default; }
  .scene-toggle:focus-visible { outline: 2px solid var(--forest); outline-offset: 3px; }
  @media (max-width: 759px) {
    .scene-window { aspect-ratio: 4 / 3; max-height: 320px; }
    .hero-scene { object-position: center top; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-scene.is-entering { animation: none; }
  }
</style>
