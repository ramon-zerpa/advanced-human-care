---
import '../styles/global.css';
import headingFont from '@fontsource/lora/files/lora-latin-600-italic.woff2?url';
import bodyFont from '@fontsource/noto-sans/files/noto-sans-latin-400-normal.woff2?url';
import buttonFont from '@fontsource/noto-sans/files/noto-sans-latin-600-normal.woff2?url';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#174A3A" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="preload" href={headingFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={buttonFont} as="font" type="font/woff2" crossorigin />
    <link rel="ai-catalog" href="/.well-known/ard.json" />
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href="#main-content">Skip to content</a><slot /></body>
</html>
