---
import PageLayout from '../../layouts/PageLayout.astro';
import Header from '../../components/Header.astro';
import Hero from '../../components/Hero.astro';
import Injuries from '../../components/Injuries.astro';
import Treatments from '../../components/Treatments.astro';
import CareSupport from '../../components/CareSupport.astro';
import Team from '../../components/Team.astro';
import Recovery from '../../components/Recovery.astro';
import FirstVisit from '../../components/FirstVisit.astro';
import Contact from '../../components/Contact.astro';
import Footer from '../../components/Footer.astro';
const title = 'Rehabilitación por accidentes de auto en Tampa | Advanced Human Care';
const description = 'Rehabilitación en Tampa para lesiones por accidentes de auto, como latigazo cervical y dolor de espalda, rodilla y hombro. Conozca al equipo de Advanced Human Care y solicite una cita.';
---
<PageLayout title={title} description={description} locale="es">
  <Header locale="es" />
  <main id="main-content" tabindex="-1"><Hero locale="es" /><Injuries locale="es" /><Treatments locale="es" /><CareSupport locale="es" /><Team locale="es" /><Recovery locale="es" /><FirstVisit locale="es" /><Contact locale="es" /></main>
  <Footer locale="es" />
</PageLayout>
